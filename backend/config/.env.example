# Copy this to .env and fill in your values

# Polymarket wallet
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_PROXY_ADDRESS=0x...
# POLYMARKET_PROXY_ADDRESS weglaten als je EOA (geen proxy wallet) gebruikt

# Signature type voor het deposit-wallet (laat leeg voor auto: 2 als proxy gezet, anders 0)
#   0 = EOA (signing key houdt zelf de funds)
#   1 = POLY_PROXY        (Polymarket email/Magic login deposit wallet)
#   2 = POLY_GNOSIS_SAFE  (browser-wallet / MetaMask login deposit wallet)
# POLYMARKET_SIGNATURE_TYPE=2

# Anthropic Claude API — vereist voor live_learning analyse en apply-learnings toggle
ANTHROPIC_API_KEY=sk-ant-...
